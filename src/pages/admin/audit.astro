---
import MainLayout from '../../layouts/MainLayout.astro';
import { requireAuth } from '../../lib/auth';

const auth = await requireAuth(Astro.cookies, 'admin');
if (!auth) return Astro.redirect('/login');

const { client, profile } = auth;

const { data: logs } = await client
  .from('audit_logs')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(200);

function fmt(t: string | null) { return t ? t.slice(0,5) : '—'; }
function fmtDate(iso: string) {
  return new Date(iso).toLocaleDateString('de-DE', {
    weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric',
    hour: '2-digit', minute: '2-digit'
  });
}
function fmtEntryDate(d: string) {
  return new Date(d).toLocaleDateString('de-DE', {
    weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric'
  });
}
---

<MainLayout title="Änderungsprotokoll" user={profile}>
  <div class="container">
    <div class="page">
      <div class="page__header">
        <h1>Änderungsprotokoll</h1>
        <a href="/admin" class="btn btn--outline">← Zurück</a>
      </div>

      <div class="card">
        {logs && logs.length > 0 ? (
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Zeitstempel</th>
                  <th>Mitarbeiter</th>
                  <th>Aktion</th>
                  <th>Datum des Eintrags</th>
                  <th>Vorher</th>
                  <th>Nachher</th>
                  <th>Wer</th>
                </tr>
              </thead>
              <tbody>
                {logs.map(log => (
                  <tr style={log.action === 'delete' ? 'background:#fff5f5' : ''}>
                    <td style="font-size:.8125rem;white-space:nowrap">{fmtDate(log.created_at)}</td>
                    <td style="font-weight:600">{log.employee_name}</td>
                    <td>
                      {log.action === 'delete'
                        ? <span style="color:#e02424;font-weight:700">🗑 Gelöscht</span>
                        : <span style="color:#1a56db;font-weight:700">✏️ Bearbeitet</span>
                      }
                    </td>
                    <td style="white-space:nowrap">{fmtEntryDate(log.entry_date)}</td>
                    <td style="font-size:.8125rem;color:#6b7280">
                      {fmt(log.old_check_in)}–{fmt(log.old_check_out)}
                      {log.old_note && <span style="display:block;font-size:.75rem">{log.old_note}</span>}
                    </td>
                    <td style="font-size:.8125rem;color:#374151">
                      {log.action === 'delete'
                        ? <span style="color:#e02424">—</span>
                        : <span>{fmt(log.new_check_in)}–{fmt(log.new_check_out)}
                          {log.new_note && <span style="display:block;font-size:.75rem">{log.new_note}</span>}
                          </span>
                      }
                    </td>
                    <td>
                      {log.performed_by === 'employee'
                        ? <span class="badge badge--employee">Mitarbeiter</span>
                        : <span class="badge badge--admin">Admin</span>
                      }
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p style="color:#6b7280;text-align:center;padding:3rem">Noch keine Änderungen protokolliert</p>
        )}
      </div>
    </div>
  </div>
</MainLayout>
